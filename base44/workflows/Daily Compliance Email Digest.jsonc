{
  "name": "Daily Compliance Email Digest",
  "description": "Emails per-venue rollup of prior day's POSTransactions and DriverPayouts to compliance_digest_emails recipients. BPAAA v3.0 audit log.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_compliance_email_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyComplianceDigest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}