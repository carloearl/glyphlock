{
  "name": "Daily Entertainer Check-In Report",
  "description": "Emails admins a summary of the last 24h of entertainer check-in activity \u2014 who's active, who checked out, per venue.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 15 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_entertainer_check_in_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyEntertainerCheckInReport",
            "args": {
              "hours": 24
            }
          },
          "then": "end"
        }
      }
    ]
  }
}