{
  "name": "JukeboxRequest",
  "type": "object",
  "properties": {
    "guest_session_id": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "track_title": {
      "type": "string",
      "description": "Cached for display"
    },
    "track_artist": {
      "type": "string"
    },
    "votes": {
      "type": "number",
      "default": 1
    },
    "tip_amount": {
      "type": "number",
      "default": 0
    },
    "is_vip": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "played",
        "rejected"
      ],
      "default": "pending"
    },
    "priority_score": {
      "type": "number"
    },
    "entertainer_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    }
  },
  "required": [
    "track_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "staff",
            "manager"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.entertainer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "staff"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}