{
  "name": "DriverPayout",
  "type": "object",
  "description": "Per-night driver earning and disbursement record. Supports guest-drop credits, GlyphBucks redemptions, settlement status, batch linkage, and strict LIVE/DEMO/SANDBOX separation.",
  "properties": {
    "payout_id": {
      "type": "string",
      "description": "Stable public payout identifier."
    },
    "contractor_id": {
      "type": "string",
      "description": "DriverProfile.driver_id or other contractor identifier."
    },
    "contractor_name": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "payout_date": {
      "type": "string",
      "format": "date"
    },
    "payout_type": {
      "type": "string",
      "enum": [
        "shift_earnings",
        "driver_credit",
        "glyphbucks_redemption",
        "vip_commission",
        "tip_share",
        "other"
      ],
      "default": "shift_earnings"
    },
    "bills_redeemed": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "total_face_value": {
      "type": "number",
      "default": 0
    },
    "redemption_rate": {
      "type": "number",
      "default": 0
    },
    "total_payout": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "ach",
        "glyphbucks",
        "other"
      ],
      "default": "cash"
    },
    "payment_reference": {
      "type": "string",
      "description": "Batch, terminal, check, ACH, or cash handoff reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "open",
        "paid",
        "voided"
      ],
      "default": "pending"
    },
    "payout_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PROCESSED"
      ],
      "default": "PENDING"
    },
    "tax_year": {
      "type": "number"
    },
    "headcount_confirmed": {
      "type": "boolean",
      "default": false
    },
    "confirmed_by": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "processed_by": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_by": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "training_session_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "driver_name": {
      "type": "string",
      "description": "Legacy alias of contractor_name."
    },
    "driver_number": {
      "type": "string",
      "description": "Legacy driver phone or badge number."
    },
    "driver_code": {
      "type": "string",
      "description": "Legacy driver code / QR payload."
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy alias of payout_date."
    },
    "drop_offs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guest_name": {
            "type": "string"
          },
          "drop_time": {
            "type": "string",
            "format": "date-time"
          },
          "has_pass": {
            "type": "boolean",
            "default": false
          },
          "pass_type": {
            "type": "string"
          },
          "went_vip": {
            "type": "boolean",
            "default": false
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "total_drops": {
      "type": "number",
      "default": 0
    },
    "vip_count": {
      "type": "number",
      "default": 0
    },
    "pass_count": {
      "type": "number",
      "default": 0
    },
    "base_payout": {
      "type": "number",
      "default": 0
    },
    "incentive_bonus": {
      "type": "number",
      "default": 0
    },
    "vip_kickback": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "payout_id",
    "contractor_id",
    "contractor_name",
    "venue_id",
    "payout_date",
    "payout_type",
    "total_payout",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "staff"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}