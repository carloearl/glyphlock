{
  "name": "UxAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "route_path": {
      "type": "string"
    },
    "has_primary_cta": {
      "type": "boolean"
    },
    "nav_consistency_score": {
      "type": "number"
    },
    "layout_consistency_score": {
      "type": "number"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "route_path"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}