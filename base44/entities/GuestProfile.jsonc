{
  "name": "GuestProfile",
  "type": "object",
  "description": "Durable guest record created on first ID scan at the door. Deduplicated by SHA-256 hash of license number (irreversible). Tracks visit history, age verification, and per-venue status (active/banned/vip). DACO-authorized PII: name, DOB, license_state \u2014 required for re-verification across visits.",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Deterministic dedup key: first 24 chars of SHA-256(license_number). One-way hash \u2014 raw license# never stored."
    },
    "venue_id": {
      "type": "string",
      "description": "Venue scope. Guest profiles are per-venue."
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Date of birth (YYYY-MM-DD). Required for re-age-verification on every visit."
    },
    "license_state": {
      "type": "string",
      "description": "Issuing state/jurisdiction (e.g. AZ, CA)."
    },
    "id_type": {
      "type": "string",
      "enum": [
        "drivers_license",
        "state_id",
        "passport",
        "military_id",
        "tribal_id"
      ],
      "default": "drivers_license",
      "description": "Government credential type. DOB is stored separately in dob."
    },
    "last_initial": {
      "type": "string",
      "maxLength": 1,
      "description": "First letter of the legal last name for quick visual verification."
    },
    "license_last4": {
      "type": "string",
      "maxLength": 4,
      "description": "Last four characters only; the full license number is never stored."
    },
    "id_expiration": {
      "type": "string",
      "format": "date",
      "description": "Credential expiration date in YYYY-MM-DD format."
    },
    "id_expired": {
      "type": "boolean",
      "default": false
    },
    "age_verified": {
      "type": "boolean",
      "default": false,
      "description": "True if age >= 21 at most recent scan."
    },
    "visit_count": {
      "type": "number",
      "default": 0
    },
    "first_visit_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_visit_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "banned",
        "vip",
        "watchlist"
      ],
      "default": "active"
    },
    "ban_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "DACO WAVE 1 \u2014 Ledger mode. REAL = live, DEMO = sandbox demo, SANDBOX = dev. Modes never mix in a report or balance."
    }
  },
  "required": [
    "guest_id",
    "venue_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "doorman"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "doorman"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "doorman"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}