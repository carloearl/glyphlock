{
  "name": "IntegrationTestAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "test_name": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "number"
    },
    "error_message": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "test_name"
  ],
  "rls": {
    "read": {
      "role": "admin"
    },
    "create": {
      "role": "admin"
    }
  }
}