{
  "name": "FeatureAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "feature_name": {
      "type": "string"
    },
    "declared_in_config": {
      "type": "boolean"
    },
    "implemented_in_routes": {
      "type": "boolean"
    },
    "implemented_in_components": {
      "type": "boolean"
    },
    "used_in_pages": {
      "type": "boolean"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "feature_name"
  ],
  "rls": {
    "read": {
      "role": "admin"
    },
    "create": {
      "role": "admin"
    }
  }
}