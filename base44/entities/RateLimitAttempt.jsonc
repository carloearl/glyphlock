{
  "name": "RateLimitAttempt",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "Resource being rate-limited (serial_number, payment_intent_id, pin_auth:<ip>, etc.)"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "bill_redemption",
        "payment_processing",
        "qr_scan",
        "pin_auth",
        "kiosk_session"
      ],
      "description": "Type of resource. pin_auth / kiosk_session added by DACO-NUPS-RBAC-CORRECTION-20260717 for server-side PIN throttling and denied-session logging (never records the PIN)."
    },
    "venue_id": {
      "type": "string",
      "description": "Venue where attempt occurred"
    },
    "actor_id": {
      "type": "string",
      "description": "User who triggered attempt"
    },
    "attempt_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "success": {
      "type": "boolean",
      "default": false
    },
    "failure_reason": {
      "type": "string"
    }
  },
  "required": [
    "resource_id",
    "resource_type",
    "attempt_timestamp"
  ]
}