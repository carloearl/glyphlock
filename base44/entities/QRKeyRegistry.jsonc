{
  "name": "QRKeyRegistry",
  "type": "object",
  "properties": {
    "kid": {
      "type": "string",
      "description": "Key ID for JWT signing"
    },
    "public_key": {
      "type": "string",
      "description": "Public key (PEM format)"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "RS256",
        "ES256",
        "EdDSA"
      ],
      "default": "RS256",
      "description": "Signing algorithm"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "rotated",
        "revoked"
      ],
      "default": "active"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "kid",
    "public_key",
    "algorithm"
  ]
}