{
  "name": "PerformanceAnalytics",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string"
    },
    "playlist_id": {
      "type": "string"
    },
    "entertainer_id": {
      "type": "string"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "avg_crowd_energy": {
      "type": "number",
      "default": 0
    },
    "avg_tips": {
      "type": "number",
      "default": 0
    },
    "playthrough_rate": {
      "type": "number",
      "default": 0
    },
    "last_played": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "track_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.entertainer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}