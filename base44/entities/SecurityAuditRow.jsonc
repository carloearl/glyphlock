{
  "name": "SecurityAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "route_path": {
      "type": "string"
    },
    "auth_required": {
      "type": "boolean"
    },
    "auth_enforced": {
      "type": "boolean"
    },
    "headers_present": {
      "type": "string"
    },
    "headers_missing": {
      "type": "string"
    },
    "sensitive_data_exposed": {
      "type": "boolean"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "route_path"
  ],
  "rls": {
    "read": {
      "role": "admin"
    },
    "create": {
      "role": "admin"
    }
  }
}