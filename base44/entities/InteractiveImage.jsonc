{
  "name": "InteractiveImage",
  "type": "object",
  "description": "User-owned interactive image lifecycle record. Drafts may be edited by their owner; finalized or published evidence is archived rather than hard-deleted.",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "generated",
        "uploaded"
      ],
      "default": "uploaded"
    },
    "fileUrl": {
      "type": "string",
      "description": "Canonical image URL used by the current Image Lab workflow."
    },
    "image_url": {
      "type": "string",
      "description": "Compatibility mirror of fileUrl."
    },
    "ownerEmail": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "fingerprint_method": {
      "type": "string",
      "enum": [
        "phash",
        "sha256"
      ],
      "default": "sha256"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "revoked"
      ],
      "default": "draft"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "immutableHash": {
      "type": "string"
    },
    "imageFileHash": {
      "type": "string"
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_by": {
      "type": "string"
    },
    "archive_reason": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "asset_id",
    "name",
    "fileUrl",
    "ownerEmail",
    "owner_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__ARCHIVE_ONLY__"
      }
    }
  }
}