{
  "name": "NUPSAccessRequest",
  "type": "object",
  "description": "Owner-reviewed requests for NUPS access. Entertainers, administrators, and owners may request access, but no applicant may self-approve.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "full_legal_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Platform-verified email of the requester."
    },
    "phone": {
      "type": "string"
    },
    "requested_role": {
      "type": "string",
      "enum": [
        "ENTERTAINER",
        "ADMINISTRATOR",
        "OWNER"
      ],
      "default": "ENTERTAINER"
    },
    "venue_id": {
      "type": "string",
      "default": "dream_palace"
    },
    "reason": {
      "type": "string",
      "description": "Why access is being requested."
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_OWNER_APPROVAL",
        "NEEDS_INFORMATION",
        "APPROVED",
        "REJECTED",
        "SUSPENDED",
        "REVOKED"
      ],
      "default": "PENDING_OWNER_APPROVAL"
    },
    "granted_role": {
      "type": "string",
      "description": "Role granted on approval."
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_note": {
      "type": "string"
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "nups_user_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "TEST",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL"
    }
  },
  "required": [
    "full_legal_name",
    "email",
    "requested_role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}