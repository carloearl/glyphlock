{
  "name": "DomainAuditRow",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scan_run_id": {
      "type": "string"
    },
    "dns_ok": {
      "type": "boolean"
    },
    "ssl_ok": {
      "type": "boolean"
    },
    "ssl_expiry_days": {
      "type": "number"
    },
    "redirect_chain_length": {
      "type": "number"
    },
    "canonical_domain_ok": {
      "type": "boolean"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
