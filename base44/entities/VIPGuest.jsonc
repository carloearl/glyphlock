{
  "name": "VIPGuest",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Deterministic dedup key: SHA-256 prefix of license number"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue scope"
    },
    "guest_profile_id": {
      "type": "string",
      "description": "Reference to canonical GuestProfile identity. VIPGuest is the venue/VIP workflow projection, not the canonical government-ID profile."
    },
    "full_name": {
      "type": "string",
      "description": "Guest full legal name"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date-time",
      "description": "DOB for age verification"
    },
    "id_type": {
      "type": "string",
      "enum": [
        "Drivers License",
        "State ID",
        "Passport",
        "Military ID",
        "Tribal ID"
      ]
    },
    "id_number": {
      "type": "string",
      "description": "LEGACY ONLY: historical government ID number. New operational writes must not persist full ID numbers."
    },
    "id_last4": {
      "type": "string",
      "maxLength": 4,
      "description": "Last four characters of the presented government ID. New operational writes retain only this suffix plus guest_id hash."
    },
    "id_state": {
      "type": "string",
      "description": "Issuing state (2-letter)"
    },
    "id_expiration": {
      "type": "string",
      "description": "ID expiration date (YYYY-MM-DD) decoded from the license barcode"
    },
    "address_line1": {
      "type": "string",
      "description": "Street address as printed on the ID"
    },
    "city": {
      "type": "string",
      "description": "City as printed on the ID"
    },
    "state": {
      "type": "string",
      "description": "Residence state as printed on the ID"
    },
    "zip_code": {
      "type": "string",
      "description": "Postal code as printed on the ID"
    },
    "id_verified": {
      "type": "boolean",
      "default": false
    },
    "id_verified_by": {
      "type": "string"
    },
    "id_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_building",
        "left_building",
        "banned",
        "vip"
      ],
      "default": "in_building"
    },
    "tier": {
      "type": "string",
      "enum": [
        "standard",
        "high_roller",
        "whale"
      ],
      "default": "standard"
    },
    "visit_count": {
      "type": "number",
      "default": 1
    },
    "last_visit": {
      "type": "string",
      "format": "date-time"
    },
    "first_visit": {
      "type": "string",
      "format": "date-time"
    },
    "card_name": {
      "type": "string",
      "description": "Name on payment card"
    },
    "card_last4": {
      "type": "string",
      "description": "Last 4 digits of card on file"
    },
    "card_exp": {
      "type": "string",
      "description": "Card expiry MM/YY"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "Visa",
        "Mastercard",
        "Amex",
        "Discover",
        "Other"
      ]
    },
    "approval_code": {
      "type": "string",
      "description": "Most recent processor approval code"
    },
    "signature_data": {
      "type": "string",
      "description": "Base64 or token of last signed contract"
    },
    "signature_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_spend_lifetime": {
      "type": "number",
      "default": 0
    },
    "vip_sessions_count": {
      "type": "number",
      "default": 0
    },
    "current_room_id": {
      "type": "string",
      "description": "VIPRoom id if currently in session"
    },
    "current_entertainer": {
      "type": "string",
      "description": "Stage name of entertainer in current session"
    },
    "notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "guest_id",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}