{
  "name": "DriverProfile",
  "type": "object",
  "description": "Durable driver record \u2014 onboarded once at the door by scanning their government ID, issued a personalized signed QR code, scanned on every subsequent visit. Tracks YTD payout for 1099 reporting. Distinct from DriverPayout (which is a per-night disbursement ledger entry). Credential storage is minimized: only the license last-4, issuing state and expiration are retained \u2014 the full ID number is never persisted.",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Unique driver identifier (e.g. DRV-{venue_short}-{seq})."
    },
    "venue_id": {
      "type": "string",
      "description": "Venue scope. Driver profiles are per-venue."
    },
    "name": {
      "type": "string",
      "description": "Driver legal name."
    },
    "phone": {
      "type": "string"
    },
    "affiliated": {
      "type": "boolean",
      "default": false,
      "description": "True = NUPS-owned/contracted driver. False = outside driver. Controls payout rate leg in VenueRateConfig."
    },
    "date_of_birth": {
      "type": "string",
      "description": "Date of birth (YYYY-MM-DD) decoded from the scanned license. Used for age verification only."
    },
    "id_type": {
      "type": "string",
      "description": "Credential type presented at onboarding (e.g. Drivers License, State ID)."
    },
    "license_last4": {
      "type": "string",
      "description": "Last 4 characters of the scanned license/ID number. The full number is intentionally NEVER stored."
    },
    "license_state": {
      "type": "string",
      "description": "Issuing state / province (2-letter) decoded from the license."
    },
    "license_expiration": {
      "type": "string",
      "description": "Credential expiration date (YYYY-MM-DD) decoded from the license."
    },
    "address_line1": {
      "type": "string",
      "description": "Street address as printed on the scanned ID."
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "id_verified": {
      "type": "boolean",
      "default": false,
      "description": "True when the credential was captured by scanning the physical ID barcode."
    },
    "id_verified_by": {
      "type": "string",
      "description": "Email of the operator who scanned and confirmed the credential."
    },
    "id_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "id_scan_source": {
      "type": "string",
      "enum": [
        "hardware_scanner",
        "manual_entry"
      ],
      "description": "How the credential was captured."
    },
    "qr_code": {
      "type": "string",
      "description": "LEGACY display token printed on the driver card. Superseded by qr_token (HMAC-signed)."
    },
    "qr_token": {
      "type": "string",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Server-signed HMAC-SHA256 QR payload (base64). Reuses the GlyphBucks/SecureQR signing pattern. The signing key NEVER leaves the server. Scannable client-side, verifiable server-side only."
    },
    "signature": {
      "type": "string",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Hex HMAC-SHA256 signature isolated from the payload for forensic comparison. Set alongside qr_token at issuance."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Server timestamp of QR issuance. Used for rotation and replay-window enforcement."
    },
    "ytd_payout_total": {
      "type": "number",
      "default": 0,
      "description": "Year-to-date payout total. Incremented atomically on every DriverPayout posting."
    },
    "ytd_year": {
      "type": "number",
      "description": "Calendar year for current ytd_payout_total. Reset January 1."
    },
    "ten99_flag": {
      "type": "boolean",
      "default": false,
      "description": "True when ytd_payout_total crosses 1099 reporting threshold ($600 IRS default; configurable per jurisdiction)."
    },
    "ten99_threshold": {
      "type": "number",
      "default": 600
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "inactive"
      ],
      "default": "active"
    },
    "lifetime_drops": {
      "type": "number",
      "default": 0
    },
    "lifetime_guests": {
      "type": "number",
      "default": 0
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarded_by": {
      "type": "string",
      "description": "Email of staff who onboarded the driver."
    },
    "notes": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger mode. REAL = live, DEMO = demo/training, SANDBOX = development."
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "training_session_id": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "venue_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff",
            "doorman"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "staff",
                "doorman"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}