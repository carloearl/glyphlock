{
  "name": "DriverProfile",
  "type": "object",
  "description": "Durable driver record \u2014 onboarded once at the door, issued a QR code, scanned on every subsequent visit. Tracks YTD payout for 1099 reporting. Distinct from DriverPayout (which is a per-night disbursement ledger entry).",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Unique driver identifier (e.g. DRV-{venue_short}-{seq})."
    },
    "venue_id": {
      "type": "string",
      "description": "Venue scope. Driver profiles are per-venue."
    },
    "name": {
      "type": "string",
      "description": "Driver legal name."
    },
    "phone": {
      "type": "string"
    },
    "affiliated": {
      "type": "boolean",
      "default": false,
      "description": "True = NUPS-owned/contracted driver. False = outside driver. Controls payout rate leg in VenueRateConfig."
    },
    "qr_code": {
      "type": "string",
      "description": "LEGACY display token printed on the driver card. Superseded by qr_token (HMAC-signed)."
    },
    "qr_token": {
      "type": "string",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Server-signed HMAC-SHA256 QR payload (base64). Reuses the GlyphBucks/SecureQR signing pattern. The signing key NEVER leaves the server. Scannable client-side, verifiable server-side only."
    },
    "signature": {
      "type": "string",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Hex HMAC-SHA256 signature isolated from the payload for forensic comparison. Set alongside qr_token at issuance."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "DACO-20260613-MOBILE-SCANNER \u2014 Server timestamp of QR issuance. Used for rotation and replay-window enforcement."
    },
    "ytd_payout_total": {
      "type": "number",
      "default": 0,
      "description": "Year-to-date payout total. Incremented atomically on every DriverPayout posting."
    },
    "ytd_year": {
      "type": "number",
      "description": "Calendar year for current ytd_payout_total. Reset January 1."
    },
    "ten99_flag": {
      "type": "boolean",
      "default": false,
      "description": "True when ytd_payout_total crosses 1099 reporting threshold ($600 IRS default; configurable per jurisdiction)."
    },
    "ten99_threshold": {
      "type": "number",
      "default": 600
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "inactive"
      ],
      "default": "active"
    },
    "lifetime_drops": {
      "type": "number",
      "default": 0
    },
    "lifetime_guests": {
      "type": "number",
      "default": 0
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time"
    },
    "onboarded_by": {
      "type": "string",
      "description": "Email of staff who onboarded the driver."
    },
    "notes": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "DACO WAVE 1 \u2014 Ledger mode. REAL = live, DEMO = sandbox demo, SANDBOX = dev. Modes never mix in a report or balance."
    }
  },
  "required": [
    "driver_id",
    "venue_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "doorman"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "doorman"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}