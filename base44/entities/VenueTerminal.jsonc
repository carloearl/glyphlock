{
  "name": "VenueTerminal",
  "type": "object",
  "description": "Trusted terminal/station registry for binding NUPS devices to venues independently of payment configuration.",
  "properties": {
    "terminal_id": {
      "type": "string",
      "description": "Stable non-secret terminal/device identifier."
    },
    "venue_id": {
      "type": "string",
      "description": "Authorized Venue.venue_id for this terminal."
    },
    "terminal_type": {
      "type": "string",
      "enum": [
        "PAYMENT_TERMINAL",
        "DOOR",
        "CLOCK",
        "DJ",
        "MANAGER",
        "SCANNER",
        "VIP",
        "KIOSK",
        "OTHER"
      ]
    },
    "station": {
      "type": "string",
      "description": "Human-readable station/workspace binding."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "revoked"
      ],
      "default": "active"
    },
    "trusted": {
      "type": "boolean",
      "default": false,
      "description": "Only trusted active terminals may establish pre-auth venue context."
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "provisioned_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "terminal_id",
    "venue_id",
    "terminal_type",
    "status",
    "trusted"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}