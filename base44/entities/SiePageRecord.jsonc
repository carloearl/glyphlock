      "type": "string",
      "maxLength": 1000
    },
    "scan_id": {
      "type": "string"
    },
    "page_name": {
      "type": "string"
    },
    "route_binding": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "error_state": {
      "type": "boolean"
    }
  },
  "required": [
    "scan_id",
    "page_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
