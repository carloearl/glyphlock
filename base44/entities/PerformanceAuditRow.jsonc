{
  "name": "PerformanceAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "route_path": {
      "type": "string"
    },
    "ttfb_ms": {
      "type": "number"
    },
    "total_load_ms": {
      "type": "number"
    },
    "largest_contentful_paint_ms": {
      "type": "number"
    },
    "status_code": {
      "type": "number"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "route_path"
  ],
  "rls": {
    "read": {
      "role": "admin"
    },
    "create": {
      "role": "admin"
    }
  }
}