{
  "name": "ServiceUsage",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string",
      "description": "Email of user (or anonymous ID for non-logged in users)"
    },
    "service_name": {
      "type": "string",
      "enum": [
        "QRGenerator",
        "Steganography",
        "Blockchain",
        "HotzoneMapper",
        "HSSS",
        "GlyphBot"
      ],
      "description": "Name of the service used"
    },
    "usage_count": {
      "type": "number",
      "default": 1,
      "description": "Number of times service was used"
    },
    "is_trial": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is trial usage"
    },
    "session_id": {
      "type": "string",
      "description": "Browser session identifier for anonymous users"
    }
  },
  "required": [
    "user_email",
    "service_name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
