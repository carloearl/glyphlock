{
  "name": "PartnerDocumentAccess",
  "type": "object",
  "description": "Per-partner access evidence for partner documents. Avoids using one global viewed flag across every partner.",
  "properties": {
    "access_key": {
      "type": "string"
    },
    "partner_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "viewed": {
      "type": "boolean",
      "default": false
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "downloaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_action": {
      "type": "string",
      "enum": [
        "view",
        "download"
      ]
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "access_key",
    "partner_id",
    "document_id",
    "actor_email",
    "last_action",
    "last_action_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__GATEWAY_ONLY__"
      }
    },
    "read": {
      "$or": [
        {
          "data.actor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__GATEWAY_ONLY__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__APPEND_ONLY_BLOCK__"
      }
    }
  }
}