{
  "name": "PaymentProvider",
  "type": "object",
  "description": "W3-008B \u2014 Payment evidence and optional integration adapters. NUPS is not the merchant processor by default: venues may keep their existing processor/terminal and use the external_terminal overlay, or enable a native API adapter such as Stripe when desired.",
  "properties": {
    "provider_code": {
      "type": "string",
      "description": "Stable unique slug. Preferred values: 'external_terminal' for bring-your-own processing, 'stripe' for optional native API integration, 'manual_external' for manager override, and 'cash'. Legacy named processor codes may remain only for backward compatibility."
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable provider name."
    },
    "adapter_type": {
      "type": "string",
      "enum": [
        "api_verify",
        "external_manual",
        "cash",
        "api_create_and_verify"
      ],
      "description": "api_verify = verify an existing processor reference via API. api_create_and_verify = create and verify through a native integration. external_manual = capture an existing processor/terminal approval or manager override without moving funds in NUPS. cash = no processor."
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields required for verification (e.g. ['processor_reference', 'approval_code', 'amount'])."
    },
    "is_external": {
      "type": "boolean",
      "default": false,
      "description": "True for manual/cash \u2014 no API calls to a processor."
    },
    "supports_refunds": {
      "type": "boolean",
      "default": true
    },
    "supports_partial_capture": {
      "type": "boolean",
      "default": false
    },
    "secret_name": {
      "type": "string",
      "description": "Name of the secret key this adapter needs (e.g. 'STRIPE_SECRET_KEY'). Empty for external/cash."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "provider_code",
    "display_name",
    "adapter_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}