{
  "name": "NUPSUser",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique username for NUPS login"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue this user belongs to"
    },
    "pin_hash": {
      "type": "string",
      "description": "DACO-NUPS-RBAC-CORRECTION-20260717 \u00a72 \u2014 PBKDF2-SHA256 (100k iterations) hex of the PIN, keyed with a unique per-account salt and the server-held KEY_PEPPER. Never returned to clients, never logged. No plaintext PIN storage exists."
    },
    "pin_salt": {
      "type": "string",
      "description": "Unique random 16-byte salt (hex) for this account's PBKDF2 PIN hash."
    },
    "pin_lookup": {
      "type": "string",
      "description": "HMAC-SHA256(pin, KEY_PEPPER) hex \u2014 deterministic peppered lookup index so PIN auth is an indexed query, not a table scan. Useless without the server secret."
    },
    "pin_hint": {
      "type": "string",
      "description": "Optional staff-set reminder phrase shown by the kiosk Hint button. Never contains the PIN itself \u2014 server rejects hints containing digit runs."
    },
    "require_platform_login": {
      "type": "boolean",
      "default": false,
      "description": "When true, PIN clock-in only succeeds while the bound platform_email is actively signed in to the platform on the device. Second factor binding."
    },
    "full_name": {
      "type": "string",
      "description": "Full name of staff member"
    },
    "role": {
      "type": "string",
      "enum": [
        "PLATFORM_ADMIN",
        "VENUE_OWNER",
        "VENUE_MANAGER",
        "FLOOR_HOST",
        "HOSTESS",
        "DOOR_GIRL",
        "DOORMAN",
        "DRIVER",
        "PERFORMER",
        "BARTENDER",
        "SECURITY",
        "DJ",
        "KIOSK",
        "DEMO",
        "SOVEREIGN"
      ],
      "default": "BARTENDER",
      "description": "RBAC role per \u00a79.2. DACO-NUPS-ROLE-VIP-BUILD-20260717 added HOSTESS (VIP contract sale workspace) and DRIVER (clock in/out only)."
    },
    "platform_email": {
      "type": "string",
      "description": "Base44 platform auth email bound to this account (owner/admin back-office sign-in)."
    },
    "approved_by": {
      "type": "string",
      "description": "Owner email that approved this account (owner/admin accounts)."
    },
    "sovereign_flag": {
      "type": "boolean",
      "default": false,
      "description": "DACO OMEGA v6.0: True only for the single SOVEREIGN account (Carlo). Bypasses all RBAC checks. Cannot be set via UI \u2014 must be set via direct entity update by platform admin."
    },
    "employee_id": {
      "type": "string",
      "description": "Employee ID number"
    },
    "phone": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "terminated"
      ],
      "default": "active"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True = demo/test account for underwriters, licensees, partners. Routes to NUPSSandbox."
    },
    "demo_tier": {
      "type": "string",
      "enum": [
        "full_demo",
        "owner_view",
        "staff_view",
        "entertainer_view"
      ],
      "description": "Controls which demo view the user lands on"
    },
    "demo_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "demo_label": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "created_note": {
      "type": "string"
    }
  },
  "required": [
    "username",
    "full_name",
    "role"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    }
  }
}