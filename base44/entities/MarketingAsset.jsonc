{
  "name": "MarketingAsset",
  "type": "object",
  "properties": {
    "asset_name": {
      "type": "string",
      "description": "Name of the marketing asset"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "brochure",
        "presentation",
        "video",
        "banner",
        "logo",
        "case_study",
        "whitepaper",
        "email_template"
      ],
      "description": "Type of marketing material"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the asset file"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "file_format": {
      "type": "string",
      "description": "File extension (pdf, png, mp4, etc.)"
    },
    "partner_tier_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bronze",
          "silver",
          "gold",
          "platinum"
        ]
      },
      "description": "Which partner tiers can access this asset"
    },
    "download_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "asset_name",
    "asset_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}