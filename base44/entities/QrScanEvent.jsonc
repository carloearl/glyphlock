{
  "name": "QrScanEvent",
  "description": "Canonical immutable QR scan evidence stream. Includes redirect analytics and structured diagnostics telemetry.",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "qrAssetId": {
      "type": "string",
      "description": "Reference to scanned QR code_id"
    },
    "scannedAt": {
      "type": "string",
      "format": "date-time"
    },
    "geoApprox": {
      "type": "string",
      "description": "Coarse location (country/region)"
    },
    "deviceHint": {
      "type": "string",
      "description": "Device type (Mobile/Desktop/Tablet)"
    },
    "userAgent": {
      "type": "string",
      "description": "Full user agent string"
    },
    "referrerHint": {
      "type": "string"
    },
    "resolvedUrl": {
      "type": "string",
      "description": "URL scanner resolved to"
    },
    "riskScoreAtScan": {
      "type": "number",
      "description": "Risk score at time of scan"
    },
    "tamperSuspected": {
      "type": "boolean",
      "default": false
    },
    "tamperReason": {
      "type": "string"
    },
    "interactionType": {
      "type": "string",
      "enum": [
        "scan",
        "tap",
        "hover",
        "hold"
      ],
      "default": "scan"
    },
    "hotZoneId": {
      "type": "string",
      "description": "If hot zone interaction"
    },
    "qr_asset_id": {
      "type": "string",
      "description": "Structured diagnostics reference to QrAsset. Retained alongside qrAssetId for compatibility."
    },
    "decoded_content": {
      "type": "string",
      "description": "Decoded QR payload captured by the protected diagnostics endpoint."
    },
    "device_context": {
      "type": "object",
      "description": "Device metadata supplied by the scanner."
    },
    "scan_velocity": {
      "type": "number",
      "description": "Matching scans observed in the preceding minute."
    },
    "scan_location": {
      "type": "object",
      "description": "Optional coarse scanner location."
    },
    "resolved_slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejection_reasons": {
      "type": "object"
    },
    "error_correction_level": {
      "type": "string",
      "enum": [
        "L",
        "M",
        "Q",
        "H"
      ]
    },
    "contrast_score": {
      "type": "number"
    },
    "quiet_zone_valid": {
      "type": "boolean"
    }
  },
  "required": [
    "qrAssetId",
    "scannedAt"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}