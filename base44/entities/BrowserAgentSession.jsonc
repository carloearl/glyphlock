{
  "name": "BrowserAgentSession",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "user_email": {
      "type": "string",
      "description": "User who initiated the session"
    },
    "task": {
      "type": "string",
      "description": "User's task description"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "failed"
      ],
      "default": "active",
      "description": "Current session status"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of executed steps with results"
    },
    "current_url": {
      "type": "string",
      "description": "Last URL analyzed"
    },
    "extracted_data": {
      "type": "object",
      "description": "Structured data extracted during session"
    },
    "step_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of steps executed"
    },
    "usage_date": {
      "type": "string",
      "format": "date",
      "description": "Date of session for daily limit tracking"
    }
  },
  "required": [
    "user_email",
    "task",
    "usage_date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
