{
  "name": "StaffShift",
  "type": "object",
  "description": "DACO-20260613-DOOR-RBAC \u2014 Non-entertainer staff shift records (Door Girl, Doorman, Bartender, Security, etc.). Identity-bound on clock-in: user_email is captured from live base44.auth.me() rebind, NEVER client-supplied. Separate from EntertainerShift so entertainer flow is undisturbed.",
  "properties": {
    "shift_id": {
      "type": "string",
      "description": "Unique shift identifier (uuid)"
    },
    "user_email": {
      "type": "string",
      "description": "Authenticated user email \u2014 bound from live base44.auth.me() at clock-in"
    },
    "user_full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "description": "Role active during shift (DOOR_GIRL, DOORMAN, BARTENDER, SECURITY, etc.)"
    },
    "venue_id": {
      "type": "string"
    },
    "station": {
      "type": "string",
      "enum": [
        "door",
        "bar",
        "vip",
        "floor",
        "office",
        "security"
      ],
      "default": "door"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "check_out_time": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last heartbeat/activity timestamp. Used to auto clock-out shifts idle > 30 minutes (device left while clocked in)."
    },
    "auto_clock_out": {
      "type": "boolean",
      "default": false,
      "description": "True when the shift was closed by the 30-minute inactivity sweep rather than an explicit clock-out."
    },
    "status": {
      "type": "string",
      "enum": [
        "checked_in",
        "checked_out",
        "contaminated_blocked"
      ],
      "default": "checked_in",
      "description": "contaminated_blocked = ID-01 rebind failed at clock-in attempt"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false,
      "description": "True iff base44.auth.me() email matched the session-claimed identity at clock-in moment"
    },
    "session_fingerprint": {
      "type": "string",
      "description": "Compact hash of {email|role|venue|userAgent} captured at clock-in for forensic trace"
    },
    "notes": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "DACO WAVE 1 \u2014 Ledger mode. REAL = live, DEMO = sandbox demo, SANDBOX = dev. Modes never mix in a report or balance."
    }
  },
  "required": [
    "user_email",
    "role",
    "check_in_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}