{
  "name": "GlyphBotFeedback",
  "type": "object",
  "properties": {
    "message_text": {
      "type": "string",
      "description": "The bot response that was rated"
    },
    "user_query": {
      "type": "string",
      "description": "What the user asked"
    },
    "rating": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ],
      "description": "Thumbs up or down"
    },
    "feedback_text": {
      "type": "string",
      "description": "Optional text feedback"
    },
    "session_id": {
      "type": "string"
    }
  },
  "required": [
    "message_text",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "role": "admin"
    },
    "update": {
      "role": "admin"
    },
    "delete": {
      "role": "admin"
    }
  }
}