{
  "name": "ScanConfig",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "manual",
        "daily",
        "weekly"
      ]
    },
    "trigger_on_deploy": {
      "type": "boolean",
      "default": false
    },
    "trigger_on_sitemap": {
      "type": "boolean",
      "default": false
    },
    "webhook_secret": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}
