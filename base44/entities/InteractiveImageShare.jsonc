{
  "name": "InteractiveImageShare",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "interactive_image_id": {
      "type": "string",
      "description": "Reference to shared InteractiveImage"
    },
    "share_url": {
      "type": "string",
      "description": "Public share URL path"
    },
    "share_mode": {
      "type": "string",
      "enum": [
        "hosted",
        "downloadable"
      ],
      "description": "Delivery mode"
    },
    "manifest_url": {
      "type": "string",
      "description": "Hotspot manifest JSON URL for downloadable mode"
    },
    "view_count": {
      "type": "integer",
      "default": 0,
      "description": "Total views"
    },
    "click_count": {
      "type": "integer",
      "default": 0,
      "description": "Total hotspot clicks"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether share link is active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration date"
    }
  },
  "required": [
    "interactive_image_id",
    "share_url",
    "share_mode"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.share_mode": "public"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
