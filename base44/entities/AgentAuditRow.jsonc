{
  "name": "AgentAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    },
    "last_success": {
      "type": "string",
      "format": "date-time"
    },
    "error_rate": {
      "type": "number"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "agent_name"
  ],
  "rls": {
    "read": {
      "role": "admin"
    },
    "create": {
      "role": "admin"
    }
  }
}