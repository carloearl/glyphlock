{
  "name": "ReconciliationException",
  "type": "object",
  "description": "W3-009/W3-010 \u2014 Payment Reconciliation Exception. Created by paymentReconciliationEngine (W3-009, read-only detection). Managed by reconciliationExceptionWorkflow (W3-010, manager review). NEVER auto-corrects financial records \u2014 observation only.",
  "properties": {
    "exception_id": {
      "type": "string",
      "description": "Unique exception identifier (RE-{venue_short}-{timestamp}-{seq})."
    },
    "reconciliation_run_id": {
      "type": "string",
      "description": "Groups all exceptions from a single reconciliation run."
    },
    "venue_id": {
      "type": "string"
    },
    "exception_type": {
      "type": "string",
      "enum": [
        "orphaned_payment_record",
        "orphaned_glyphbucks_order",
        "orphaned_glyphbucks_batch",
        "amount_mismatch_payment_to_order",
        "amount_mismatch_order_to_batch",
        "bill_count_mismatch",
        "bill_face_value_mismatch",
        "duplicate_processor_reference",
        "payment_record_stuck_pending",
        "unconfirmed_payment_record_with_bills",
        "issued_bills_without_ledger_posting",
        "ledger_posting_without_payment_record"
      ],
      "description": "Type of discrepancy detected."
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "info"
      ],
      "default": "warning"
    },
    "entity_type": {
      "type": "string",
      "description": "Which entity type this exception is about."
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the primary entity involved."
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the discrepancy."
    },
    "expected_value": {
      "type": "string"
    },
    "actual_value": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "detected_by": {
      "type": "string",
      "description": "Email of admin who triggered the run, or 'automation'."
    },
    "status": {
      "type": "string",
      "enum": [
        "NEW",
        "UNDER_REVIEW",
        "NEEDS_INFORMATION",
        "ESCALATED",
        "RESOLVED",
        "FALSE_POSITIVE",
        "ARCHIVED"
      ],
      "default": "NEW",
      "description": "W3-010 review workflow status."
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the manager currently assigned."
    },
    "assigned_to_role": {
      "type": "string",
      "description": "Assignment target category: self, manager, accounting, corporate, compliance, ownership."
    },
    "assignment_history": {
      "type": "array",
      "description": "Permanent, append-only assignment log.",
      "items": {
        "type": "object",
        "properties": {
          "assigned_to": {
            "type": "string"
          },
          "assigned_to_role": {
            "type": "string"
          },
          "assigned_by": {
            "type": "string"
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "review_notes": {
      "type": "array",
      "description": "Immutable, append-only notes. Edits create new versions. Deletion prohibited.",
      "items": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "author_role": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "number"
          }
        }
      }
    },
    "transition_history": {
      "type": "array",
      "description": "Permanent, append-only status transition log.",
      "items": {
        "type": "object",
        "properties": {
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "escalated": {
      "type": "boolean",
      "default": false,
      "description": "True when this exception has been escalated to corporate/compliance."
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalated_by": {
      "type": "string"
    },
    "escalation_reason": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "True when a dashboard alert has been generated."
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL"
    }
  },
  "required": [
    "exception_id",
    "reconciliation_run_id",
    "venue_id",
    "exception_type",
    "severity",
    "entity_type",
    "entity_id",
    "description",
    "detected_at"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}