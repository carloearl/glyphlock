{
  "name": "SieFindingRecord",
  "type": "object",
  "properties": {
    "scan_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "headers",
        "auth_boundary",
        "endpoint_exposure",
        "error_handling",
        "session",
        "logging"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "description": {
      "type": "string"
    },
    "evidence_reference": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "category",
    "severity",
    "description"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}