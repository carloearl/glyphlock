{
  "name": "POSTransaction",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Unique transaction identifier"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "tip": {
      "type": "number"
    },
    "processing_fee": {
      "type": "number",
      "default": 0,
      "description": "Card processing fee charged to the guest on this transaction (rate \u00d7 subtotal). Included in `total`. Read from VenueRateConfig.cc_processing_fee_rate at write time."
    },
    "service_fee": {
      "type": "number",
      "default": 0,
      "description": "Service fee line charged to the guest (rate \u00d7 subtotal). Included in `total`. Read from VenueRateConfig.service_fee_pct at write time, only when show_service_fee=true."
    },
    "total": {
      "type": "number",
      "description": "Gross transaction total. NEVER reduced by driver payouts or comps \u2014 gross stays on the books so accounting can see the comp gap."
    },
    "cash_sales": {
      "type": "number",
      "description": "Cash portion. Component of total_sales rollup. ZERO when payment_method=Comp."
    },
    "card_sales": {
      "type": "number",
      "description": "Card portion. Component of total_sales rollup. ZERO when payment_method=Comp."
    },
    "gb_liability": {
      "type": "number",
      "default": 0,
      "description": "GlyphBucks face value sold. STORED-VALUE LIABILITY. Never counted as revenue, never added to total_sales."
    },
    "comp_amount": {
      "type": "number",
      "default": 0,
      "description": "Gross value comped on this transaction. payment_method=Comp \u21d2 comp_amount = total. Tracked as accounting GAP \u2014 never revenue, never disbursement."
    },
    "comp_authorized_by": {
      "type": "string",
      "description": "Manager full name / email who authorized the comp. Captured at payment time via PIN re-verification."
    },
    "comp_authorized_by_id": {
      "type": "string",
      "description": "NUPSUser id of the authorizing manager."
    },
    "comp_reason": {
      "type": "string",
      "description": "Categorical reason (VIP, industry, owner guest, etc.) plus optional free-text note."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash",
        "Credit Card",
        "Debit Card",
        "Digital Wallet",
        "Gift Card",
        "Tab",
        "GlyphBucks",
        "Comp",
        "Other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "void",
        "refunded",
        "held"
      ],
      "default": "completed"
    },
    "refund_reference": {
      "type": "string",
      "description": "Processor/terminal/cash-return reference supplied when the refund is completed."
    },
    "refund_reason": {
      "type": "string"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time"
    },
    "refunded_by": {
      "type": "string"
    },
    "station": {
      "type": "string",
      "enum": [
        "door",
        "bar",
        "vip",
        "kiosk",
        "office"
      ],
      "description": "Physical station that posted the sale."
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger mode. REAL writes to live books; DEMO/SANDBOX are funds-off."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Explicit cleanup/isolation marker. True for DEMO, TRAINING, and SANDBOX records."
    },
    "training_session_id": {
      "type": "string",
      "description": "Session boundary for guided TRAINING mode, which persists on the DEMO ledger."
    },
    "validation_run": {
      "type": "boolean",
      "default": false,
      "description": "DACO-20260613-DOOR-RBAC \u2014 true = funds-off validation run. Quarantined from booked revenue and DailySettlement. Door Girl writes are forced true at the gateway."
    },
    "funds_settled": {
      "type": "boolean",
      "default": true,
      "description": "DACO-20260613-DOOR-RBAC \u2014 false when validation_run=true. Excludes record from settlement rollups."
    },
    "cashier_role": {
      "type": "string",
      "description": "DACO-20260613-DOOR-RBAC \u2014 Role the cashier held at write time. Audit field for identity-binding proof. Nullable for legacy records."
    },
    "venue_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string",
      "description": "Owning POSBatch."
    },
    "terminal_id": {
      "type": "string"
    },
    "cashier": {
      "type": "string",
      "description": "Legacy field \u2014 email or display name. Receipt prefers cashier_name."
    },
    "cashier_name": {
      "type": "string",
      "description": "Resolved display name. Fixes 'Cashier: N/A' defect."
    },
    "cashier_email": {
      "type": "string"
    },
    "cashier_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "card_last_four": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "auth_code": {
      "type": "string"
    },
    "payment_source": {
      "type": "string",
      "description": "How tender approval was captured (external terminal confirmation, provider integration, or training simulation)."
    },
    "payment_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cash_tendered": {
      "type": "number"
    },
    "change_due": {
      "type": "number"
    },
    "gift_card": {
      "type": "boolean"
    },
    "gift_card_number": {
      "type": "string"
    },
    "room_tab": {
      "type": "boolean"
    },
    "room_tab_reference": {
      "type": "string"
    },
    "receipt_hash": {
      "type": "string",
      "description": "SHA-256 hex fingerprint of the transaction payload (buildReceiptPayload). Persisted at write time so the printed hash on the receipt is auditable and verifiable after the fact. Tamper-evident anchor for blockchain proof exports."
    },
    "receipt_hash_version": {
      "type": "number",
      "default": 1,
      "description": "Version of the receipt hash payload schema. Bump when buildReceiptPayload changes so historic hashes can still be reproduced."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "items",
    "total",
    "payment_method"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "staff"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}