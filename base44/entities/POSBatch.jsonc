{
  "name": "POSBatch",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "Unique batch identifier"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue this batch belongs to"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "opening_cash": {
      "type": "number"
    },
    "closing_cash": {
      "type": "number"
    },
    "total_sales": {
      "type": "number"
    },
    "transaction_count": {
      "type": "number"
    },
    "cashier": {
      "type": "string"
    },
    "cashier_email": {
      "type": "string"
    },
    "cashier_name": {
      "type": "string"
    },
    "opened_by": {
      "type": "string",
      "description": "Manager who opened the batch (Manager Console only)."
    },
    "door_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Two-step open: manager opens the batch, then the Front Door operator confirms it before the first transaction of the shift can post."
    },
    "door_confirmed_by": {
      "type": "string",
      "description": "Door operator who confirmed the batch."
    },
    "door_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "REQUIRES_REVIEW",
        "void"
      ],
      "default": "open"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger boundary for this shift batch."
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "training_session_id": {
      "type": "string"
    },
    "discrepancy": {
      "type": "number",
      "default": 0
    },
    "original_closing_cash": {
      "type": "number"
    },
    "closing_cash_entered_by": {
      "type": "string"
    },
    "closing_cash_entered_at": {
      "type": "string",
      "format": "date-time"
    },
    "discrepancy_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "opening_cash",
    "cashier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}