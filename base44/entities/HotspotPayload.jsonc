{
  "name": "HotspotPayload",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "payload_id": {
      "type": "string",
      "description": "Unique payload identifier"
    },
    "hotspot_id": {
      "type": "string",
      "description": "Foreign key to Hotspot"
    },
    "payload_type": {
      "type": "string",
      "enum": [
        "url",
        "api_trigger",
        "modal_content",
        "internal_route",
        "analytics_event"
      ],
      "description": "Type of payload action"
    },
    "payload_url": {
      "type": "string",
      "description": "HTTPS URL (required when payload_type is url)"
    }
  },
  "required": [
    "payload_id",
    "hotspot_id",
    "payload_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
