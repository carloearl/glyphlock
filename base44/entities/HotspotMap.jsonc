{
  "name": "HotspotMap",
  "type": "object",
  "properties": {
    "map_id": {
      "type": "string",
      "description": "Unique map identifier"
    },
    "asset_id": {
      "type": "string",
      "description": "Foreign key to InteractiveImage"
    },
    "map_version": {
      "type": "string",
      "default": "v1",
      "description": "Map schema version"
    }
  },
  "required": [
    "map_id",
    "asset_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}