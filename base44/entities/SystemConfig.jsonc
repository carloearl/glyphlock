{
  "name": "SystemConfig",
  "type": "object",
  "description": "Platform configuration. Supports global mode (config_key: 'global') and per-venue mode (config_key: 'venue', venue_id set). Per-venue takes priority; global is the fallback.",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Config scope key. Use 'global' for platform-wide, 'venue' for per-venue (requires venue_id)."
    },
    "venue_id": {
      "type": "string",
      "description": "DACO WAVE 1 \u2014 When config_key is 'venue', this identifies which venue the config applies to. Null for global config."
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "description": "Active platform mode. Single source of truth for writeEntity gateway. Per-venue record takes priority over global."
    },
    "tier": {
      "type": "string",
      "enum": [
        "TIER_1_OBSERVE",
        "TIER_2_LOCKED",
        "TIER_3_SECTIONAL",
        "TIER_4_TOTAL"
      ],
      "default": "TIER_1_OBSERVE",
      "description": "Active write-gateway enforcement tier."
    },
    "sovereign_user_id": {
      "type": "string",
      "description": "NUPSUser id of the bound SOVEREIGN account. Set once at bootstrap."
    },
    "sovereign_email": {
      "type": "string",
      "description": "Email of the bound SOVEREIGN account."
    },
    "bootstrap_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When SOVEREIGN was first bound. Immutable."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}