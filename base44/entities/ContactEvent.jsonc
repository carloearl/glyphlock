{
  "name": "ContactEvent",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Email of person contacting"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of person contacting"
    },
    "subject": {
      "type": "string",
      "description": "Subject line"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Email delivery status"
    },
    "ip_address": {
      "type": "string",
      "description": "Sender IP for security"
    },
    "public_update_token_hash": {
      "type": "string",
      "description": "Server-only SHA-256 hash of a short-lived anonymous submission update token. Never return to clients."
    },
    "public_update_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiry for anonymous same-submission delivery-status updates."
    }
  },
  "required": [
    "contact_email",
    "contact_name",
    "subject",
    "message"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
