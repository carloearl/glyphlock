{
  "name": "ContactEvent",
  "type": "object",
  "properties": {
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Email of person contacting"
    },
    "contact_name": {
      "type": "string",
      "description": "Name of person contacting"
    },
    "subject": {
      "type": "string",
      "description": "Subject line"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Email delivery status"
    },
    "ip_address": {
      "type": "string",
      "description": "Sender IP for security"
    }
  },
  "required": [
    "contact_email",
    "contact_name",
    "subject",
    "message"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    }
  }
}