{
  "name": "SieFeatureRecord",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scan_id": {
      "type": "string"
    },
    "feature_name": {
      "type": "string"
    },
    "declared": {
      "type": "boolean"
    },
    "implemented": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "full"
      ]
    },
    "used": {
      "type": "boolean"
    }
  },
  "required": [
    "scan_id",
    "feature_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
