{
  "name": "VenueContract",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "Unique contract identifier"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue where this contract was created"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "VIP Package",
        "GlyphBucks Purchase",
        "Entertainer Agreement",
        "Service Agreement",
        "Custom"
      ],
      "description": "Classification of contract"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to customer"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_id_number": {
      "type": "string",
      "description": "Government ID number of customer"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_state": {
      "type": "string"
    },
    "customer_zip": {
      "type": "string"
    },
    "entertainer_id": {
      "type": "string",
      "description": "Optional \u2014 reference to Entertainer if contract involves a performer"
    },
    "entertainer_name": {
      "type": "string"
    },
    "contract_amount": {
      "type": "number",
      "description": "Total monetary value of contract"
    },
    "glyphbucks_issued": {
      "type": "number",
      "default": 0,
      "description": "GlyphBucks face value issued under this contract"
    },
    "processing_surcharge": {
      "type": "number",
      "default": 0
    },
    "waitress_tip": {
      "type": "number",
      "default": 0
    },
    "grand_total": {
      "type": "number",
      "default": 0
    },
    "glyphbucks_transaction_id": {
      "type": "string",
      "description": "Links to GlyphBucksTransaction if GB were issued"
    },
    "vip_session_id": {
      "type": "string",
      "description": "Optional \u2014 links to VIPRoom session"
    },
    "batch_id": {
      "type": "string",
      "description": "POSBatch this contract falls under"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash",
        "Credit Card",
        "Debit Card",
        "GlyphBucks",
        "Split"
      ],
      "default": "Cash"
    },
    "purchaser_card_name": {
      "type": "string"
    },
    "card_last_four": {
      "type": "string"
    },
    "card_exp": {
      "type": "string"
    },
    "approval_code": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "is_printed": {
      "type": "boolean",
      "default": false,
      "description": "Whether hardcopy has been printed"
    },
    "is_signed": {
      "type": "boolean",
      "default": false,
      "description": "Whether customer has signed"
    },
    "customer_signature": {
      "type": "string",
      "description": "Digital signature data"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "manager_id": {
      "type": "string",
      "description": "Manager who authorized contract"
    },
    "audit_log_id": {
      "type": "string",
      "description": "Reference to SystemAuditLog entry"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "fulfilled",
        "voided",
        "disputed"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "scanned_document_url": {
      "type": "string",
      "description": "URL of the uploaded signed hardcopy scan"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when document was scanned"
    },
    "scanned_by": {
      "type": "string",
      "description": "Email of staff who scanned the document"
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCANNED",
        "VERIFIED"
      ],
      "default": "PENDING",
      "description": "Status of the physical document scan"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "True for demo/sandbox records \u2014 never shown in production reports"
    },
    "demo_label": {
      "type": "string",
      "description": "Human-readable label for demo records"
    }
  },
  "required": [
    "contract_id",
    "contract_type",
    "customer_name",
    "contract_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "staff"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "staff"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}