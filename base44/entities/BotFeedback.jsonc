{
  "name": "BotFeedback",
  "type": "object",
  "description": "DACO 006-A \u2014 GlyphBot product-domain feedback (GLYPHBOT product, NOT a NUPS venue entity). Direct writes, anonymous raters allowed (R-006A-2). Analytics defaults to app_env=production only. No user message content stored (F-3).",
  "properties": {
    "product": {
      "type": "string",
      "default": "glyphbot",
      "description": "Product domain stamp."
    },
    "surface": {
      "type": "string",
      "description": "Where the rating came from: glyphbot_main, glyphbot_jr_public, etc."
    },
    "app_env": {
      "type": "string",
      "enum": [
        "production",
        "preview"
      ],
      "description": "Deployment environment stamp. Analytics defaults to production only (contamination guard on the correct axis)."
    },
    "conversation_id": {
      "type": "string",
      "description": "Groups feedback to a chat session."
    },
    "message_id": {
      "type": "string",
      "description": "The specific bot response rated."
    },
    "persona_id": {
      "type": "string",
      "description": "Which agent produced the response (glyphbot, glyphbot_jr, ...)."
    },
    "rating": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "feedback_text": {
      "type": "string",
      "description": "Optional free-text comment, max length from feedbackConfig."
    },
    "response_preview": {
      "type": "string",
      "description": "First N chars of the rated bot response. Bot output only \u2014 never user message content."
    },
    "user_role": {
      "type": "string",
      "description": "Rater's role if authenticated, else 'anonymous'."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "message_id",
    "persona_id",
    "rating"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}