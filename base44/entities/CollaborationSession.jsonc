{
  "name": "CollaborationSession",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "hostId": {
      "type": "string"
    },
    "activeUsers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastUpdate": {
      "type": "string",
      "format": "date-time"
    },
    "currentState": {
      "type": "object"
    }
  },
  "required": [
    "projectId",
    "hostId"
  ],
  "rls": {
    "create": {
      "data.hostId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.activeUsers": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.activeUsers": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.hostId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}