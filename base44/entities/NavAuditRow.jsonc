{
  "name": "NavAuditRow",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scan_run_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "admin",
        "internal"
      ]
    },
    "http_status": {
      "type": "number"
    },
    "page_exists": {
      "type": "boolean"
    },
    "backend_exists": {
      "type": "boolean"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "path"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
