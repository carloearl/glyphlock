{
  "name": "SiteAudit",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "audit_type": {
      "type": "string",
      "enum": [
        "security",
        "performance",
        "seo",
        "ux",
        "full"
      ],
      "default": "full",
      "description": "Type of audit performed"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "overall_score": {
      "type": "number",
      "description": "Overall site health score 0-100"
    },
    "security_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "line_number": {
            "type": "number"
          },
          "cwe_id": {
            "type": "string"
          },
          "owasp_category": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "auto_fixable": {
            "type": "boolean"
          },
          "fix_code": {
            "type": "string"
          }
        }
      },
      "description": "Security vulnerabilities detected"
    },
    "performance_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "current_value": {
            "type": "string"
          },
          "target_value": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "auto_fixable": {
            "type": "boolean"
          }
        }
      },
      "description": "Performance bottlenecks"
    },
    "seo_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "page_path": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "auto_fixable": {
            "type": "boolean"
          }
        }
      },
      "description": "SEO issues"
    },
    "ux_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "component_path": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "auto_fixable": {
            "type": "boolean"
          }
        }
      },
      "description": "UX improvement areas"
    },
    "security_measurement_status": {
      "type": "string",
      "enum": [
        "verified_source",
        "no_data_available"
      ],
      "description": "Whether security findings were grounded in verified repository source content"
    },
    "performance_measurement_status": {
      "type": "string",
      "enum": [
        "measured",
        "no_data_available"
      ],
      "description": "Whether real PageSpeed/Lighthouse performance data was available"
    },
    "seo_measurement_status": {
      "type": "string",
      "enum": [
        "measured",
        "no_data_available"
      ],
      "description": "Whether real PageSpeed or crawler SEO data was available"
    },
    "ux_measurement_status": {
      "type": "string",
      "enum": [
        "measured",
        "no_data_available"
      ],
      "description": "Whether real Lighthouse accessibility data was available"
    },
    "source_commit_sha": {
      "type": "string",
      "description": "Git commit SHA used to build the verified source evidence bundle"
    },
    "source_inventory_count": {
      "type": "number",
      "description": "Number of auditable files in the verified repository inventory"
    },
    "audit_url": {
      "type": "string",
      "format": "uri",
      "description": "Public GlyphLock URL measured by PageSpeed and crawler evidence"
    },
    "invalid_findings_discarded": {
      "type": "number",
      "default": 0,
      "description": "Model findings rejected because they lacked verified source or measurement evidence"
    },
    "evidence_summary": {
      "type": "string",
      "maxLength": 10000,
      "description": "Compact JSON summary of measurement availability and identifiers"
    },
    "files_scanned": {
      "type": "number",
      "description": "Actual number of repository source files supplied to the audit model"
    },
    "execution_time_ms": {
      "type": "number",
      "description": "Time taken to complete audit"
    },
    "auto_fixes_applied": {
      "type": "number",
      "default": 0,
      "description": "Number of issues auto-fixed"
    },
    "fix_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "applied_at": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "audit_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}