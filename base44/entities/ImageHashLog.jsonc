{
  "name": "ImageHashLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "imageId": {
      "type": "string",
      "description": "Reference to InteractiveImage"
    },
    "hash": {
      "type": "string",
      "description": "SHA-256 hash of canonical JSON"
    },
    "imageFileHash": {
      "type": "string",
      "description": "SHA-256 hash of image file bytes"
    },
    "hotspotsSnapshot": {
      "type": "string",
      "description": "JSON snapshot of hotspots at finalization time"
    },
    "ownerEmail": {
      "type": "string",
      "description": "Email of the user who finalized this"
    }
  },
  "required": [
    "imageId",
    "hash",
    "imageFileHash",
    "hotspotsSnapshot",
    "ownerEmail"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
