{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "name": {
      "type": "string"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue scope for the entertainer playlist."
    },
    "entertainer_id": {
      "type": "string"
    },
    "persona_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "ordered_tracks": {
      "type": "array",
      "description": "Array of {track_id, score, reason, position}",
      "items": {
        "type": "object"
      }
    },
    "crowd_energy_score": {
      "type": "number"
    },
    "generation_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "venue_id",
    "entertainer_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.entertainer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
