{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "entertainer_id": {
      "type": "string"
    },
    "persona_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "ordered_tracks": {
      "type": "array",
      "description": "Array of {track_id, score, reason, position}",
      "items": {
        "type": "object"
      }
    },
    "crowd_energy_score": {
      "type": "number"
    },
    "generation_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "entertainer_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "dj"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.entertainer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "dj"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "dj"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "dj"
          ]
        }
      }
    }
  }
}