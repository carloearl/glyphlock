{
  "name": "Entertainer",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "stage_name": {
      "type": "string",
      "description": "Professional stage name"
    },
    "legal_name": {
      "type": "string",
      "description": "Full legal name"
    },
    "venue_id": {
      "type": "string",
      "description": "Primary venue this entertainer belongs to"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "emergency_contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        }
      }
    },
    "date_of_birth": {
      "type": "string",
      "description": "Date of birth for age verification"
    },
    "id_type": {
      "type": "string",
      "description": "Credential type presented at onboarding (Drivers License, State ID, adult entertainment license)."
    },
    "license_number_last4": {
      "type": "string",
      "description": "Last 4 characters of the license/ID number. The full number is intentionally NEVER stored."
    },
    "license_state": {
      "type": "string",
      "description": "Issuing state / province (2-letter)."
    },
    "license_expiration": {
      "type": "string",
      "description": "Credential expiration date (YYYY-MM-DD). Required for check-in; expired blocks check-in and cash payout."
    },
    "license_photo_url": {
      "type": "string",
      "description": "Uploaded photo of the FRONT of the adult-entertainment license / ID. Retained as credential evidence."
    },
    "id_verified": {
      "type": "boolean",
      "default": false,
      "description": "True when the credential was captured by scanning the physical ID barcode or verified against an uploaded license photo."
    },
    "id_verified_by": {
      "type": "string",
      "description": "Email of the operator who captured/confirmed the credential."
    },
    "id_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "id_scan_source": {
      "type": "string",
      "enum": [
        "hardware_scanner",
        "photo_upload",
        "manual_entry"
      ],
      "description": "How the credential was captured."
    },
    "payout_hold": {
      "type": "boolean",
      "default": false,
      "description": "True when the license is expired/missing \u2014 nightly cash payout is withheld and accrues as an IOU."
    },
    "iou_balance": {
      "type": "number",
      "default": 0,
      "description": "Accrued earnings owed but withheld while the license is invalid. Released once a valid license is on file."
    },
    "contract_signed": {
      "type": "boolean",
      "default": false,
      "description": "Clickwrap agreement signed"
    },
    "contract_signature": {
      "type": "string",
      "description": "Digital signature of contract"
    },
    "contract_signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "contract_ip_address": {
      "type": "string",
      "description": "IP address where contract was signed"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "VALID",
        "INVALID",
        "PENDING",
        "EXPIRED",
        "REVOKED"
      ],
      "default": "INVALID",
      "description": "Contract validation status. Must be VALID for check-in."
    },
    "nups_pin": {
      "type": "string",
      "description": "4-digit PIN the entertainer enters at the door check-in kiosk."
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Set true for demo seed records to isolate from production queries"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          }
        }
      }
    },
    "commission_rate": {
      "type": "number",
      "default": 0.5,
      "description": "Commission percentage (0-1)"
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "vip_room_count": {
      "type": "number",
      "default": 0
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger mode."
    }
  },
  "required": [
    "stage_name",
    "legal_name",
    "contract_signed"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}