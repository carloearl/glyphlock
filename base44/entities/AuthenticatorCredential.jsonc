{
  "name": "AuthenticatorCredential",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "account_name": {
      "type": "string",
      "description": "Display name for the account (e.g., GitHub, Google)"
    },
    "issuer": {
      "type": "string",
      "description": "Service issuer name"
    },
    "secret": {
      "type": "string",
      "description": "Base32 encoded secret key"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "SHA1",
        "SHA256",
        "SHA512"
      ],
      "default": "SHA1",
      "description": "TOTP algorithm"
    },
    "digits": {
      "type": "number",
      "default": 6,
      "description": "Number of digits in code (6 or 8)"
    },
    "period": {
      "type": "number",
      "default": 30,
      "description": "Time period in seconds"
    },
    "icon_url": {
      "type": "string",
      "description": "Custom icon URL for the service"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "Mark as favorite"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Custom sort order"
    }
  },
  "required": [
    "account_name",
    "secret"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}
