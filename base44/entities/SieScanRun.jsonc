{
  "name": "SieScanRun",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "scan_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "duration": {
      "type": "number"
    },
    "success": {
      "type": "boolean"
    },
    "error_count": {
      "type": "number"
    },
    "artifacts": {
      "type": "object",
      "description": "JSON storage of the 5 artifacts for export"
    }
  },
  "required": [
    "scan_id",
    "timestamp",
    "success"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
