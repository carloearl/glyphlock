{
  "name": "VenueRateConfig",
  "type": "object",
  "description": "Per-venue editable rate sheet. Single source of truth for cover charges, re-entry fees, driver payouts, bonus tiers, and receipt-level configuration (legal name, processing fee, service fee, footer text, tax id). NEVER hardcode any of these values in logic \u2014 always read from this entity. Seeded once per venue; admin-editable thereafter.",
  "properties": {
    "venue_id": {
      "type": "string",
      "description": "Foreign key to Venue. One config per venue."
    },
    "venue_name": {
      "type": "string",
      "description": "Display label only \u2014 not used in logic."
    },
    "cover_charge": {
      "type": "number",
      "default": 20,
      "description": "Standard cover charge in USD."
    },
    "house_fee": {
      "type": "number",
      "default": 20,
      "minimum": 0,
      "description": "Entertainer house fee in USD. Kept separate from guest cover charge."
    },
    "glyphbucks_tender_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allows LIVE house-fee/POS payment using a verified GlyphBucks liability-ledger workflow."
    },
    "reentry_charge": {
      "type": "number",
      "default": 10,
      "description": "Reduced re-entry fee in USD."
    },
    "card_discount": {
      "type": "number",
      "default": 10,
      "description": "Discount applied when guest pays cover by card (affiliated driver formula leg). USD."
    },
    "vip_entry": {
      "type": "number",
      "default": 100,
      "description": "VIP entry charge."
    },
    "bottle_service_base": {
      "type": "number",
      "default": 250,
      "description": "Default bottle service price."
    },
    "two_drink_min": {
      "type": "number",
      "default": 25,
      "description": "Two-drink minimum charge."
    },
    "late_night_fee": {
      "type": "number",
      "default": 15
    },
    "friends_military": {
      "type": "number",
      "default": 10,
      "description": "Discounted cover for friends / military."
    },
    "driver_payout_affiliated": {
      "type": "number",
      "default": 30,
      "description": "Per-guest payout in USD for affiliated (NUPS-owned) drivers."
    },
    "driver_payout_outside": {
      "type": "number",
      "default": 20,
      "description": "Per-guest payout in USD for outside / unaffiliated drivers."
    },
    "driver_bonus_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "e.g. 'Weekend', 'Special Event'"
          },
          "applies_when": {
            "type": "string",
            "description": "Day of week or event tag"
          },
          "bonus_amount": {
            "type": "number"
          }
        }
      },
      "description": "Editable bonus rules added to driver payout formula. Empty array = no bonus."
    },
    "tax_rate": {
      "type": "number",
      "default": 0.08,
      "description": "Sales tax rate (0.08 = 8%). Applied to bar/VIP transactions. Door cover charges are tax-exempt."
    },
    "cc_processing_fee_rate": {
      "type": "number",
      "default": 0.05,
      "description": "Credit card processing fee rate (0.05 = 5%). Applied at the door register when guest pays by card."
    },
    "service_fee_pct": {
      "type": "number",
      "default": 0,
      "description": "Optional service fee percentage applied to POS transactions and shown as a distinct line on the receipt. 0 = disabled. Expressed as a decimal (0.05 = 5%)."
    },
    "service_fee_label": {
      "type": "string",
      "default": "Service Fee",
      "description": "Label printed on the receipt for the service fee line."
    },
    "show_processing_fee": {
      "type": "boolean",
      "default": true,
      "description": "When true, receipts print a Processing Fee line (rate + amount)."
    },
    "show_service_fee": {
      "type": "boolean",
      "default": false,
      "description": "When true, receipts print a Service Fee line at service_fee_pct."
    },
    "payment_terminal_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True only when a physical/payment-provider terminal workflow has been configured and verified."
    },
    "gift_card_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Shows the Gift Card tender in LIVE mode when the venue has a supported balance/authorization workflow."
    },
    "room_tab_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Shows Room Tab tender in LIVE mode when the venue has a supported tab workflow."
    },
    "receipt_auto_prompt": {
      "type": "boolean",
      "default": true,
      "description": "Open the receipt confirmation after a completed POS transaction."
    },
    "receipt_print_copies": {
      "type": "number",
      "default": 1,
      "minimum": 1,
      "maximum": 3,
      "description": "Default receipt-copy count presented to the operator."
    },
    "receipt_legal_name": {
      "type": "string",
      "default": "",
      "description": "Legal entity name printed as the main header on every receipt."
    },
    "receipt_footer_text": {
      "type": "string",
      "default": "",
      "description": "Custom footer paragraph printed at the bottom of every receipt."
    },
    "receipt_tax_id": {
      "type": "string",
      "default": "",
      "description": "Legal / tax id printed on the receipt header. Empty = hidden."
    },
    "promo_card_amount": {
      "type": "number",
      "default": 5,
      "description": "Dollar value of the one-tap door promo card button (e.g. $5 OFF)."
    },
    "house_commission_rate": {
      "type": "number",
      "default": 0.4,
      "description": "House commission rate for entertainer earnings."
    },
    "driver_payout_treatment": {
      "type": "string",
      "enum": [
        "UNSET",
        "HOUSE_ABSORBED",
        "GUEST_DISCOUNT"
      ],
      "default": "UNSET",
      "description": "BPAA-NUPS-ACCT-001 \u00a77 \u2014 DACO ruling required. UNSET blocks all driver payout posting."
    },
    "tax_mode": {
      "type": "string",
      "enum": [
        "NONE",
        "EXCLUSIVE",
        "INCLUSIVE"
      ],
      "default": "NONE",
      "description": "BPAA-NUPS-ACCT-001 \u2014 tax treatment for non-door revenue."
    },
    "tax_rate_bps": {
      "type": "number",
      "default": 0,
      "description": "BPAA-NUPS-ACCT-001 \u2014 tax rate in basis points (integer). 800 = 8.00%."
    },
    "track_cogs": {
      "type": "boolean",
      "default": false,
      "description": "BPAA-NUPS-ACCT-001 \u2014 when true, every sale posts a COGS leg."
    },
    "processing_fee_account": {
      "type": "string",
      "default": "6100",
      "description": "BPAA-NUPS-ACCT-001 \u2014 account code for card processing fees."
    },
    "breakage_policy": {
      "type": "string",
      "enum": [
        "NONE",
        "ON_EXPIRY",
        "PERIODIC"
      ],
      "default": "NONE",
      "description": "BPAA-NUPS-ACCT-001 \u00a76 \u2014 GlyphBucks breakage recognition policy."
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger mode. REAL writes to live books; DEMO is sandbox; SANDBOX is dev-only."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_edited_by": {
      "type": "string"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "venue_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}