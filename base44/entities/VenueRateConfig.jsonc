{
  "name": "VenueRateConfig",
  "type": "object",
  "description": "Per-venue editable rate sheet. Single source of truth for cover charges, re-entry fees, driver payouts, bonus tiers, and receipt-level configuration (processing fee, service fee, footer text, tax id). NEVER hardcode any of these values in logic \u2014 always read from this entity. Seeded once per venue; admin-editable thereafter.",
  "properties": {
    "venue_id": {
      "type": "string",
      "description": "Foreign key to Venue. One config per venue."
    },
    "venue_name": {
      "type": "string",
      "description": "Display label only \u2014 not used in logic."
    },
    "cover_charge": {
      "type": "number",
      "default": 20,
      "description": "Standard cover charge in USD. Read by door POS Cover \u2014 Cash / Cover \u2014 Card buttons."
    },
    "reentry_charge": {
      "type": "number",
      "default": 10,
      "description": "Reduced re-entry fee in USD."
    },
    "card_discount": {
      "type": "number",
      "default": 10,
      "description": "Discount applied when guest pays cover by card (affiliated driver formula leg). USD."
    },
    "vip_entry": {
      "type": "number",
      "default": 100,
      "description": "VIP entry charge."
    },
    "bottle_service_base": {
      "type": "number",
      "default": 250,
      "description": "Default bottle service price."
    },
    "two_drink_min": {
      "type": "number",
      "default": 25,
      "description": "Two-drink minimum charge."
    },
    "late_night_fee": {
      "type": "number",
      "default": 15
    },
    "friends_military": {
      "type": "number",
      "default": 10,
      "description": "Discounted cover for friends / military."
    },
    "driver_payout_affiliated": {
      "type": "number",
      "default": 30,
      "description": "Per-guest payout in USD for affiliated (NUPS-owned) drivers."
    },
    "driver_payout_outside": {
      "type": "number",
      "default": 20,
      "description": "Per-guest payout in USD for outside / unaffiliated drivers."
    },
    "driver_bonus_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "e.g. 'Weekend', 'Special Event'"
          },
          "applies_when": {
            "type": "string",
            "description": "Day of week or event tag"
          },
          "bonus_amount": {
            "type": "number"
          }
        }
      },
      "description": "Editable bonus rules added to driver payout formula. Empty array = no bonus."
    },
    "tax_rate": {
      "type": "number",
      "default": 0.08
    },
    "cc_processing_fee_rate": {
      "type": "number",
      "default": 0.035,
      "description": "Credit card processing fee rate applied at the door register only. Door cover charges are sales-tax-exempt; this rate is the pass-through processor fee added when the guest pays cover by card."
    },
    "service_fee_pct": {
      "type": "number",
      "default": 0,
      "description": "Optional service fee percentage applied to POS transactions and shown as a distinct line on the receipt. 0 = disabled. Expressed as a decimal (0.05 = 5%)."
    },
    "service_fee_label": {
      "type": "string",
      "default": "Service Fee",
      "description": "Label printed on the receipt for the service fee line."
    },
    "show_processing_fee": {
      "type": "boolean",
      "default": true,
      "description": "When true, receipts print a Processing Fee line (rate + amount). Turn off if the fee is absorbed by the house."
    },
    "show_service_fee": {
      "type": "boolean",
      "default": false,
      "description": "When true, receipts print a Service Fee line at service_fee_pct."
    },
    "receipt_footer_text": {
      "type": "string",
      "default": "",
      "description": "Custom footer paragraph printed at the bottom of every receipt (return policy, event, promotion). Empty falls back to the default 'Thank you for your patronage' block."
    },
    "receipt_tax_id": {
      "type": "string",
      "default": "",
      "description": "Legal / tax id printed on the receipt header (EIN, resale, business license #). Empty = hidden."
    },
    "promo_card_amount": {
      "type": "number",
      "default": 5,
      "description": "Dollar value of the one-tap door promo card button (e.g. $5 OFF). Each use posts a negative line item with is_promo:true so accounting can count usage."
    },
    "house_commission_rate": {
      "type": "number",
      "default": 0.4,
      "description": "House commission rate for entertainer earnings."
    },
    "driver_payout_treatment": {
      "type": "string",
      "enum": [
        "UNSET",
        "HOUSE_ABSORBED",
        "GUEST_DISCOUNT"
      ],
      "default": "UNSET",
      "description": "BPAA-NUPS-ACCT-001 \u00a77 \u2014 DACO ruling required. UNSET blocks all driver payout posting. HOUSE_ABSORBED = revenue gross, payout is 6000 Driver Payout Expense. GUEST_DISCOUNT = revenue net of payout; no expense line."
    },
    "tax_mode": {
      "type": "string",
      "enum": [
        "NONE",
        "EXCLUSIVE",
        "INCLUSIVE"
      ],
      "default": "NONE",
      "description": "BPAA-NUPS-ACCT-001 \u2014 tax treatment for non-door revenue. NONE = no tax line. EXCLUSIVE = tax added on top. INCLUSIVE = tax embedded; gross split into net + tax for posting."
    },
    "tax_rate_bps": {
      "type": "number",
      "default": 0,
      "description": "BPAA-NUPS-ACCT-001 \u2014 tax rate in basis points (integer). 800 = 8.00%. Replaces float tax_rate for ledger math (I-2)."
    },
    "track_cogs": {
      "type": "boolean",
      "default": false,
      "description": "BPAA-NUPS-ACCT-001 \u2014 when true, every sale posts a COGS leg (5000 COGS / 1200 Inventory). Defer until cost data is reliable."
    },
    "processing_fee_account": {
      "type": "string",
      "default": "6100",
      "description": "BPAA-NUPS-ACCT-001 \u2014 account code for card processing fees. Default 6100."
    },
    "breakage_policy": {
      "type": "string",
      "enum": [
        "NONE",
        "ON_EXPIRY",
        "PERIODIC"
      ],
      "default": "NONE",
      "description": "BPAA-NUPS-ACCT-001 \u00a76 \u2014 GlyphBucks breakage recognition policy. Leave NONE until DACO sets policy."
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "Ledger mode. REAL writes to live books; DEMO is sandbox; SANDBOX is dev-only. Door + driver writes must honor this."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_edited_by": {
      "type": "string"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "venue_id"
  ]
}