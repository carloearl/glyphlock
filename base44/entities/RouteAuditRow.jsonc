{
  "name": "RouteAuditRow",
  "type": "object",
  "properties": {
    "scan_run_id": {
      "type": "string"
    },
    "route_path": {
      "type": "string"
    },
    "component_name": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean"
    },
    "http_status": {
      "type": "number"
    },
    "has_auth_guard": {
      "type": "boolean"
    },
    "violation_ids": {
      "type": "string"
    },
    "violation_messages": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "critical"
      ]
    },
    "required_action": {
      "type": "string"
    }
  },
  "required": [
    "scan_run_id",
    "route_path"
  ],
  "rls": {
    "read": true,
    "create": true
  }
}