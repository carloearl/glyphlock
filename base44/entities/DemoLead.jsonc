{
  "name": "DemoLead",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "full_name": {
      "type": "string",
      "description": "Prospect full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Prospect email"
    },
    "venue_name": {
      "type": "string",
      "description": "Prospect venue name"
    },
    "session_token": {
      "type": "string",
      "description": "Unique single-use session token"
    },
    "session_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "COMPLETED"
      ],
      "default": "ACTIVE"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "email_dispatch_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "SENT",
        "FAILED"
      ],
      "default": "PENDING"
    },
    "email_dispatch_error": {
      "type": "string"
    },
    "email_transport": {
      "type": "string",
      "enum": [
        "SENDGRID",
        "CORE_SENDMAIL",
        "FAILED",
        "NONE"
      ],
      "default": "NONE",
      "description": "Which transport was used for follow-up email dispatch"
    },
    "email_dispatch_detail": {
      "type": "string",
      "description": "Dispatch error message or provider detail"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of successful email dispatch"
    },
    "referral_source": {
      "type": "string",
      "description": "Which preview/entry surface produced this lead (e.g. pos-register-preview)"
    },
    "action_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "source_route": {
            "type": "string"
          },
          "device_fingerprint": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "full_name",
    "email",
    "venue_name",
    "session_token"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sales_manager"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
