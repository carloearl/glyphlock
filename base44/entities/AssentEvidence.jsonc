{
  "name": "AssentEvidence",
  "type": "object",
  "description": "DACO GlyphBucks — clickwrap + identity + e-signature evidence for one sealed sale. Stores match scores and template/reference hashes ONLY — never raw biometrics or images beyond the retained presence photo reference. Timeline must be monotonic and physically plausible. RLS: admin-only direct access — most sensitive PII in the GlyphBucks chain; all writes are server-side only.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "verify_ref": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "clickwrap_accepted": {
      "type": "boolean",
      "default": false
    },
    "terms_shown_at": {
      "type": "string",
      "format": "date-time"
    },
    "scroll_depth_pct": {
      "type": "number"
    },
    "dwell_seconds": {
      "type": "number"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "initials_term1": {
      "type": "string",
      "description": "Purchaser initials for Term 1 (nature of transaction) — captured at clickwrap."
    },
    "initials_term3": {
      "type": "string",
      "description": "Purchaser initials for Term 3 (non-refundable) — captured at clickwrap."
    },
    "ip": {
      "type": "string"
    },
    "id_scan_ref": {
      "type": "string"
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "face_id_match_pct": {
      "type": "number"
    },
    "thumbprint_match_pct": {
      "type": "number"
    },
    "card_auth_code": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "card_entry": {
      "type": "string",
      "enum": [
        "CHIP",
        "EMV",
        "SWIPE",
        "MANUAL"
      ],
      "default": "CHIP"
    },
    "esig_purchaser_ref": {
      "type": "string",
      "description": "/s/ electronic signature — purchaser."
    },
    "esig_issuer_rep_ref": {
      "type": "string",
      "description": "/s/ electronic signature — issuer rep (cashier)."
    },
    "esig_manager_ref": {
      "type": "string",
      "description": "/s/ electronic signature — approving manager (MUST be a distinct person from the issuer rep; carries the auth ref)."
    },
    "delivery_printed_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_emailed_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_sms_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "DEMO"
    }
  },
  "required": [
    "verify_ref",
    "venue_id",
    "clickwrap_accepted"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
