{
  "name": "AssentEvidence",
  "type": "object",
  "description": "DACO GlyphBucks \u2014 clickwrap + identity + e-signature evidence for one sealed sale. Stores match scores and template/reference hashes ONLY \u2014 never raw biometrics or images beyond the retained presence photo reference. Timeline must be monotonic and physically plausible.",
  "properties": {
    "verify_ref": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "clickwrap_accepted": {
      "type": "boolean",
      "default": false
    },
    "terms_shown_at": {
      "type": "string",
      "format": "date-time"
    },
    "scroll_depth_pct": {
      "type": "number"
    },
    "dwell_seconds": {
      "type": "number"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "initials_term1": {
      "type": "string",
      "description": "Purchaser initials for Term 1 (nature of transaction) \u2014 captured at clickwrap."
    },
    "initials_term3": {
      "type": "string",
      "description": "Purchaser initials for Term 3 (non-refundable) \u2014 captured at clickwrap."
    },
    "ip": {
      "type": "string"
    },
    "id_scan_ref": {
      "type": "string"
    },
    "age_verified": {
      "type": "boolean",
      "default": false
    },
    "face_id_match_pct": {
      "type": "number"
    },
    "thumbprint_match_pct": {
      "type": "number"
    },
    "card_auth_code": {
      "type": "string"
    },
    "card_last4": {
      "type": "string"
    },
    "card_entry": {
      "type": "string",
      "enum": [
        "CHIP",
        "EMV",
        "SWIPE",
        "MANUAL"
      ],
      "default": "CHIP"
    },
    "esig_purchaser_ref": {
      "type": "string",
      "description": "/s/ electronic signature \u2014 purchaser."
    },
    "esig_issuer_rep_ref": {
      "type": "string",
      "description": "/s/ electronic signature \u2014 issuer rep (cashier)."
    },
    "esig_manager_ref": {
      "type": "string",
      "description": "/s/ electronic signature \u2014 approving manager (MUST be a distinct person from the issuer rep; carries the auth ref)."
    },
    "delivery_printed_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_emailed_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_sms_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "DEMO"
    }
  },
  "required": [
    "verify_ref",
    "venue_id",
    "clickwrap_accepted"
  ]
}