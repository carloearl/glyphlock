{
  "name": "EntertainerShift",
  "type": "object",
  "properties": {
    "entertainer_id": {
      "type": "string",
      "description": "Foreign key reference to Entertainer entity"
    },
    "entertainer_type": {
      "type": "string",
      "enum": [
        "entertainer",
        "nups_user",
        "demo_seed",
        "orphaned"
      ],
      "default": "entertainer",
      "description": "ID-01: Identifies which entity type the entertainer_id field resolves against"
    },
    "venue_id": {
      "type": "string",
      "description": "Venue where this shift is worked"
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time"
    },
    "check_out_time": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string",
      "enum": [
        "Main Floor",
        "VIP Area",
        "Private Room",
        "Bar",
        "Stage"
      ],
      "description": "Current location"
    },
    "status": {
      "type": "string",
      "enum": [
        "checked_in",
        "on_floor",
        "in_vip",
        "on_break",
        "checked_out"
      ],
      "default": "checked_in"
    },
    "shift_earnings": {
      "type": "number",
      "default": 0
    },
    "vip_sessions": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "description": "Audit/remediation notes (e.g. DACO directive closures)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "REAL",
        "DEMO",
        "SANDBOX"
      ],
      "default": "REAL",
      "description": "DACO WAVE 1 \u2014 Ledger mode. REAL = live, DEMO = sandbox demo, SANDBOX = dev. Modes never mix in a report or balance."
    }
  },
  "required": [
    "entertainer_id",
    "check_in_time"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "floor_host"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.entertainer_id": "{{user.id}}"
        },
        {
          "data.venue_id": "{{user.data.venue_id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "manager",
                "floor_host"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager",
            "floor_host"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "manager"
          ]
        }
      }
    }
  }
}