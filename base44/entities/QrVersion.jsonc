{
  "name": "QrVersion",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "created_by": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "design_config": {
      "type": "object"
    },
    "change_log": {
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "version_number",
    "payload"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}