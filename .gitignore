# -----------------------------------------------------------------------------
# Secrets and environment configuration
# -----------------------------------------------------------------------------
# Real environment files must never be committed. Placeholder templates are
# allowed so required variable names can be documented safely.
.env
.env.*
*.env
*.env.*
.envrc
.direnv/
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

# Local overrides
*.local
*.local.*
config/local.*

# Secret stores, OAuth credentials, service accounts, API-key exports
.secrets
.secrets.*
**/.secrets
**/.secrets.*
secrets.json
secrets.yaml
secrets.yml
secrets.toml
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/secrets.toml
**/*-secrets.json
**/*_secrets.json
**/client_secret*.json
**/client-secret*.json
**/oauth-client*.json
**/oauth_client*.json
**/credentials.json
**/*-credentials.json
**/*_credentials.json
**/service-account*.json
**/service_account*.json
**/firebase-adminsdk*.json
**/google-credentials*.json
**/api-keys.json
**/api_keys.json
**/token.json
**/tokens.json
**/*refresh-token*.json

# Private keys, signing material, keystores and certificate bundles
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519

# Package-manager / CLI credentials
.npmrc
.pypirc
.netrc
.yarnrc.local

