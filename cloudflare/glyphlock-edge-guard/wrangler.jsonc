{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glyphlock-edge-guard",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "glyphlock.io/*",
      "zone_name": "glyphlock.io"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
